# =============================================================================
# SNACKAPP - Variables d'environnement
# =============================================================================
# Copiez ce fichier vers .env et remplissez les valeurs
# IMPORTANT: Ne JAMAIS commiter le fichier .env dans git
#
# Usage: Chaque instance devrait avoir son propre .env ou backend-config.php
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Environnement (development, staging, production)
APP_ENV=production

# Mode debug (true/false) - TOUJOURS false en production
APP_DEBUG=false

# Timezone
APP_TIMEZONE=Europe/Paris

# Devise par defaut
APP_CURRENCY=EUR

# -----------------------------------------------------------------------------
# BASE DE DONNEES
# -----------------------------------------------------------------------------

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_secure_password_here
DB_CHARSET=utf8mb4

# -----------------------------------------------------------------------------
# STRIPE (Paiement en ligne)
# -----------------------------------------------------------------------------

# Mode Stripe (test ou live)
STRIPE_MODE=test

# Cles TEST (commencent par pk_test_ et sk_test_)
STRIPE_PUBLISHABLE_KEY_TEST=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY_TEST=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET_TEST=whsec_xxxxxxxxxxxx

# Cles LIVE (commencent par pk_live_ et sk_live_)
STRIPE_PUBLISHABLE_KEY_LIVE=pk_live_xxxxxxxxxxxx
STRIPE_SECRET_KEY_LIVE=sk_live_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET_LIVE=whsec_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# RESTAURANT
# -----------------------------------------------------------------------------

# ID du restaurant dans la base de donnees
RESTAURANT_ID=1

# Instance (identifiant unique)
INSTANCE_ID=my-restaurant

# -----------------------------------------------------------------------------
# WHATSAPP (Notifications)
# -----------------------------------------------------------------------------

# Numero WhatsApp pour les notifications (format international sans +)
WHATSAPP_ORDERS_NUMBER=33612345678

# -----------------------------------------------------------------------------
# SMTP (Emails - optionnel)
# -----------------------------------------------------------------------------

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=noreply@example.com
MAIL_PASSWORD=your_mail_password
MAIL_FROM_NAME="Mon Restaurant"
MAIL_FROM_ADDRESS=noreply@example.com

# -----------------------------------------------------------------------------
# SECURITE
# -----------------------------------------------------------------------------

# Cle secrete pour les tokens (generez une cle aleatoire de 64 caracteres)
APP_SECRET_KEY=your_64_character_random_secret_key_here

# Duree de session en secondes (8 heures par defaut)
SESSION_LIFETIME=28800

# -----------------------------------------------------------------------------
# DOMAINES AUTORISES (CORS)
# -----------------------------------------------------------------------------

# Domaines autorises separes par des virgules
# En production, listez uniquement vos domaines
ALLOWED_ORIGINS=https://monrestaurant.com,https://www.monrestaurant.com

# -----------------------------------------------------------------------------
# LOGS
# -----------------------------------------------------------------------------

# Niveau de log (debug, info, warning, error)
LOG_LEVEL=warning

# Chemin du fichier de log (relatif a la racine)
LOG_PATH=logs/app.log
