<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Votre Panier - Finaliser la Commande | Fabrik Burger</title>
    <meta name="description" content="Finalisez votre commande chez Fabrik Burger. Vérifiez votre panier et validez pour un retrait Click & Collect rapide.">
    <meta name="robots" content="noindex, nofollow">

    <!-- Favicon & Theme -->
    <link rel="icon" type="image/svg+xml" href="../images/fabriklogo.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="../images/favicon-32x32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="../images/apple-touch-icon.png">
    <meta name="theme-color" content="#e63946">

    <!-- Styles -->
    <link rel="stylesheet" href="css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        /* Cart Page Specific Styles */
        .cart-page {
            min-height: 100vh;
            background: var(--gray-50);
        }

        .cart-header {
            background: var(--white);
            padding: 20px 24px;
            border-bottom: 1px solid var(--gray-200);
            display: flex;
            align-items: center;
            gap: 16px;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .cart-header .back-btn {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-600);
            transition: var(--transition);
        }

        .cart-header .back-btn:hover {
            background: var(--gray-100);
            color: var(--gray-900);
        }

        .cart-header h1 {
            font-size: 20px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-header h1 i {
            color: var(--primary);
        }

        .cart-container {
            max-width: 900px;
            margin: 0 auto;
            padding: 24px;
        }

        .cart-empty {
            text-align: center;
            padding: 60px 20px;
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
        }

        .cart-empty i {
            font-size: 64px;
            color: var(--gray-300);
            margin-bottom: 20px;
        }

        .cart-empty h2 {
            font-size: 20px;
            color: var(--gray-800);
            margin-bottom: 8px;
        }

        .cart-empty p {
            color: var(--gray-500);
            margin-bottom: 24px;
        }

        .cart-empty .btn {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: var(--primary);
            color: var(--white);
            padding: 12px 24px;
            border-radius: var(--border-radius-sm);
            font-weight: 600;
            transition: var(--transition);
        }

        .cart-empty .btn:hover {
            background: var(--primary-dark);
        }

        .cart-section {
            background: var(--white);
            border-radius: var(--border-radius);
            box-shadow: var(--shadow);
            margin-bottom: 24px;
            overflow: hidden;
        }

        .cart-section-header {
            padding: 16px 20px;
            border-bottom: 1px solid var(--gray-100);
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .cart-section-header i {
            color: var(--primary);
        }

        .clear-cart-btn {
            background: var(--error);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: var(--border-radius-sm);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .clear-cart-btn:hover {
            background: #c0392b;
            transform: scale(1.02);
        }

        .clear-cart-btn i {
            color: white;
            font-size: 11px;
        }

        /* Cart Items */
        .cart-item {
            display: flex;
            gap: 16px;
            padding: 20px;
            border-bottom: 1px solid var(--gray-100);
            transition: var(--transition);
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .cart-item:hover {
            background: var(--gray-50);
        }

        .cart-item-image {
            width: 80px;
            height: 80px;
            border-radius: var(--border-radius-sm);
            object-fit: cover;
            flex-shrink: 0;
        }

        .cart-item-details {
            flex: 1;
            min-width: 0;
        }

        .cart-item-name {
            font-weight: 600;
            font-size: 16px;
            margin-bottom: 4px;
        }

        .cart-item-supplements {
            font-size: 13px;
            color: var(--gray-500);
            margin-bottom: 8px;
        }

        .cart-item-price {
            font-weight: 700;
            color: var(--primary);
            font-size: 16px;
        }

        .cart-item-actions {
            display: flex;
            flex-direction: column;
            align-items: flex-end;
            gap: 12px;
        }

        .cart-item-remove {
            color: var(--gray-400);
            padding: 8px;
            transition: var(--transition);
            background: none;
            border: none;
            cursor: pointer;
            font-size: 16px;
        }

        .cart-item-remove:hover {
            color: var(--error);
            transform: scale(1.1);
        }

        .cart-item-qty {
            display: flex;
            align-items: center;
            background: var(--gray-100);
            border-radius: var(--border-radius-sm);
        }

        .cart-item-qty button {
            width: 32px;
            height: 32px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-600);
            transition: var(--transition);
        }

        .cart-item-qty button:hover {
            color: var(--primary);
        }

        .cart-item-qty span {
            min-width: 32px;
            text-align: center;
            font-weight: 600;
        }

        /* Upsell Section */
        .upsell-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
            gap: 12px;
            padding: 20px;
        }

        .upsell-card {
            background: var(--gray-50);
            border-radius: var(--border-radius-sm);
            padding: 12px;
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
            border: 2px solid transparent;
        }

        .upsell-card:hover {
            border-color: var(--primary);
            background: var(--primary-light);
        }

        .upsell-card img {
            width: 60px;
            height: 60px;
            border-radius: var(--border-radius-sm);
            object-fit: cover;
            margin: 0 auto 8px;
        }

        .upsell-placeholder {
            width: 60px;
            height: 60px;
            border-radius: var(--border-radius-sm);
            background: var(--gray-200);
            margin: 0 auto 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--gray-400);
            font-size: 24px;
        }

        .upsell-card-name {
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 4px;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .upsell-card-price {
            font-size: 14px;
            color: var(--primary);
            font-weight: 700;
        }

        /* Checkout Form */
        .checkout-form {
            padding: 20px;
        }

        .form-row {
            margin-bottom: 16px;
        }

        .form-row label {
            display: block;
            font-weight: 600;
            font-size: 14px;
            margin-bottom: 8px;
            color: var(--gray-700);
        }

        .form-row input,
        .form-row select {
            width: 100%;
            padding: 12px 16px;
            border: 1px solid var(--gray-300);
            border-radius: var(--border-radius-sm);
            font-size: 15px;
            transition: var(--transition);
        }

        .form-row input:focus,
        .form-row select:focus {
            outline: none;
            border-color: var(--primary);
            box-shadow: 0 0 0 3px var(--primary-light);
        }

        .form-row-inline {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .mode-selector {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .mode-option {
            padding: 16px;
            border: 2px solid var(--gray-200);
            border-radius: var(--border-radius-sm);
            text-align: center;
            cursor: pointer;
            transition: var(--transition);
        }

        .mode-option.selected {
            border-color: var(--primary);
            background: var(--primary-light);
        }

        .mode-option i {
            font-size: 24px;
            margin-bottom: 8px;
            color: var(--gray-500);
        }

        .mode-option.selected i {
            color: var(--primary);
        }

        .mode-option span {
            display: block;
            font-weight: 600;
            font-size: 14px;
        }

        /* Cart Summary */
        .cart-summary {
            padding: 20px;
        }

        .cart-summary-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            font-size: 15px;
        }

        .cart-summary-row.total {
            border-top: 2px solid var(--gray-200);
            margin-top: 12px;
            padding-top: 16px;
            font-size: 18px;
            font-weight: 700;
        }

        .cart-summary-row.total .price {
            color: var(--primary);
            font-size: 22px;
        }

        /* Submit Button */
        .submit-order {
            width: 100%;
            padding: 16px;
            background: var(--primary);
            color: var(--white);
            border: none;
            border-radius: var(--border-radius-sm);
            font-size: 16px;
            font-weight: 700;
            cursor: pointer;
            transition: var(--transition);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-top: 16px;
        }

        .submit-order:hover {
            background: var(--primary-dark);
            transform: translateY(-2px);
            box-shadow: var(--shadow-md);
        }

        .submit-order:disabled {
            background: var(--gray-400);
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

        /* Promo Code */
        .promo-row {
            display: flex;
            gap: 12px;
        }

        .promo-row input {
            flex: 1;
        }

        .promo-row button {
            padding: 12px 20px;
            background: var(--gray-800);
            color: var(--white);
            border-radius: var(--border-radius-sm);
            font-weight: 600;
            transition: var(--transition);
        }

        .promo-row button:hover {
            background: var(--gray-900);
        }

        /* Confirmation Modal */
        .confirmation-modal {
            position: fixed;
            inset: 0;
            z-index: 300;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            opacity: 0;
            visibility: hidden;
            transition: var(--transition);
        }

        .confirmation-modal.active {
            opacity: 1;
            visibility: visible;
        }

        .confirmation-content {
            background: var(--white);
            border-radius: var(--border-radius-lg);
            padding: 32px;
            max-width: 450px;
            width: 90%;
            text-align: center;
            transform: scale(0.9);
            transition: var(--transition);
        }

        .confirmation-modal.active .confirmation-content {
            transform: scale(1);
        }

        .confirmation-icon {
            width: 80px;
            height: 80px;
            border-radius: 50%;
            background: var(--success);
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 40px;
            margin: 0 auto 20px;
        }

        .confirmation-content h2 {
            font-size: 24px;
            margin-bottom: 8px;
        }

        .confirmation-content p {
            color: var(--gray-600);
            margin-bottom: 8px;
        }

        .confirmation-content .order-number {
            font-size: 28px;
            font-weight: 800;
            color: var(--primary);
            margin: 16px 0;
        }

        .confirmation-actions {
            display: flex;
            flex-direction: column;
            gap: 12px;
            margin-top: 24px;
        }

        .btn-whatsapp {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 14px;
            background: #25D366;
            color: var(--white);
            border-radius: var(--border-radius-sm);
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-whatsapp:hover {
            background: #128C7E;
        }

        .btn-secondary {
            padding: 14px;
            background: var(--gray-100);
            color: var(--gray-700);
            border-radius: var(--border-radius-sm);
            font-weight: 600;
            transition: var(--transition);
        }

        .btn-secondary:hover {
            background: var(--gray-200);
        }

        @media (max-width: 640px) {
            .cart-container {
                padding: 16px;
            }

            .cart-item {
                flex-wrap: wrap;
            }

            .cart-item-image {
                width: 70px;
                height: 70px;
            }

            .cart-item-actions {
                width: 100%;
                flex-direction: row;
                justify-content: space-between;
                margin-top: 12px;
            }

            .form-row-inline {
                grid-template-columns: 1fr;
            }

            .upsell-grid {
                grid-template-columns: repeat(2, 1fr);
            }
        }
    </style>
</head>
<body class="cart-page">
    <!-- Header -->
    <header class="cart-header">
        <a href="index.html" class="back-btn">
            <i class="fas fa-arrow-left"></i>
        </a>
        <h1><i class="fas fa-shopping-bag"></i> Votre Commande</h1>
    </header>

    <!-- Cart Container -->
    <div class="cart-container">
        <!-- Empty Cart State -->
        <div class="cart-empty" id="cartEmpty" style="display: none;">
            <i class="fas fa-shopping-bag"></i>
            <h2>Votre panier est vide</h2>
            <p>Ajoutez des produits pour commencer votre commande</p>
            <a href="index.html" class="btn">
                <i class="fas fa-utensils"></i>
                Voir le menu
            </a>
        </div>

        <!-- Cart Content -->
        <div id="cartContent">
            <!-- Cart Items -->
            <section class="cart-section">
                <div class="cart-section-header" style="justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <i class="fas fa-shopping-basket"></i>
                        Vos articles
                    </div>
                    <button class="clear-cart-btn" onclick="CartPage.clearCart()">
                        <i class="fas fa-trash-alt"></i> Vider
                    </button>
                </div>
                <div id="cartItems">
                    <!-- Items will be rendered here -->
                </div>
            </section>

            <!-- Upsell Section -->
            <section class="cart-section" id="upsellSection">
                <div class="cart-section-header">
                    <i class="fas fa-lightbulb"></i>
                    <span id="upsellMessage">Complétez votre commande</span>
                </div>
                <div class="upsell-grid" id="upsellGrid">
                    <!-- Upsell items will be rendered here -->
                </div>
            </section>

            <!-- Customer Info -->
            <section class="cart-section">
                <div class="cart-section-header">
                    <i class="fas fa-user"></i>
                    Vos informations
                </div>
                <form class="checkout-form" id="checkoutForm">
                    <div class="form-row">
                        <label>Mode de retrait</label>
                        <div class="mode-selector" style="grid-template-columns: repeat(3, 1fr);">
                            <div class="mode-option" data-mode="dinein" onclick="CartPage.setMode('dinein')">
                                <i class="fas fa-utensils"></i>
                                <span>Sur place</span>
                            </div>
                            <div class="mode-option selected" data-mode="pickup" onclick="CartPage.setMode('pickup')">
                                <i class="fas fa-shopping-bag"></i>
                                <span>À emporter</span>
                            </div>
                            <div class="mode-option" data-mode="delivery" onclick="CartPage.setMode('delivery')">
                                <i class="fas fa-motorcycle"></i>
                                <span>Livraison</span>
                            </div>
                        </div>
                    </div>

                    <div class="form-row-inline">
                        <div class="form-row">
                            <label for="customerName">Nom *</label>
                            <input type="text" id="customerName" placeholder="Votre nom" required>
                        </div>
                        <div class="form-row">
                            <label for="customerPhone"><i class="fab fa-whatsapp" style="color: #25D366;"></i> WhatsApp *</label>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <select id="countryCode" required style="flex: 0 0 auto; width: 160px; padding: 12px; border: 2px solid var(--gray-200); border-radius: 12px; font-size: 14px; background: white; cursor: pointer;">
                                    <option value="">Pays *</option>
                                    <option value="+213">🇩🇿 Algérie (+213)</option>
                                    <option value="+33">🇫🇷 France (+33)</option>
                                    <option value="+966">🇸🇦 Arabie S. (+966)</option>
                                    <option value="+20">🇪🇬 Égypte (+20)</option>
                                    <option value="+44">🇬🇧 Angleterre (+44)</option>
                                    <option value="+971">🇦🇪 Émirats (+971)</option>
                                    <option value="+1">🇨🇦 Canada (+1)</option>
                                    <option value="+216">🇹🇳 Tunisie (+216)</option>
                                    <option value="+212">🇲🇦 Maroc (+212)</option>
                                    <option value="+221">🇸🇳 Sénégal (+221)</option>
                                    <option value="+223">🇲🇱 Mali (+223)</option>
                                    <option value="+86">🇨🇳 Chine (+86)</option>
                                </select>
                                <input type="tel" id="customerPhone" placeholder="6 12 34 56 78" required style="flex: 1; padding: 12px; border: 2px solid var(--gray-200); border-radius: 12px; font-size: 14px;">
                            </div>
                            <small style="color: var(--gray-500); font-size: 12px; margin-top: 4px; display: block;">Recevez votre confirmation sur WhatsApp</small>
                        </div>
                    </div>

                    <!-- Champs Sur place -->
                    <div id="dineinFields" style="display: none;">
                        <div class="form-row">
                            <label>Salle *</label>
                            <div class="mode-selector" style="grid-template-columns: repeat(2, 1fr); gap: 10px;">
                                <div class="mode-option" data-room="famille" onclick="CartPage.setRoom('famille')">
                                    <i class="fas fa-users"></i>
                                    <span>Salle Famille</span>
                                </div>
                                <div class="mode-option" data-room="femme" onclick="CartPage.setRoom('femme')">
                                    <i class="fas fa-female"></i>
                                    <span>Salle Femme</span>
                                </div>
                            </div>
                        </div>
                        <div class="form-row">
                            <label for="tableNumber">Numéro de table *</label>
                            <input type="text" id="tableNumber" placeholder="Ex: F12" style="text-transform: uppercase;">
                        </div>
                    </div>

                    <!-- Champs Livraison -->
                    <div id="deliveryFields" style="display: none;">
                        <div class="form-row">
                            <label>Type de livraison *</label>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="radio" name="deliveryType" value="libre" onchange="CartPage.setDeliveryType('libre')" checked>
                                    <span>Adresse libre</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="radio" name="deliveryType" value="riad-city" onchange="CartPage.setDeliveryType('riad-city')">
                                    <span>Riad City</span>
                                </label>
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer;">
                                    <input type="radio" name="deliveryType" value="riad-prestige" onchange="CartPage.setDeliveryType('riad-prestige')">
                                    <span>Riad Prestige</span>
                                </label>
                            </div>
                        </div>

                        <!-- Adresse libre -->
                        <div id="deliveryLibre" class="form-row">
                            <label for="customerAddress">Adresse *</label>
                            <input type="text" id="customerAddress" placeholder="Votre adresse complète">
                        </div>

                        <!-- Riad City -->
                        <div id="deliveryRiadCity" class="form-row" style="display: none;">
                            <label>Riad City *</label>
                            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 10px;">
                                <select id="riadCityBat" class="input">
                                    <option value="">Sélectionnez le bâtiment *</option>
                                    <option value="A">Bâtiment A</option>
                                    <option value="B">Bâtiment B</option>
                                    <option value="C">Bâtiment C</option>
                                    <option value="D">Bâtiment D</option>
                                    <option value="E">Bâtiment E</option>
                                    <option value="F">Bâtiment F</option>
                                    <option value="G">Bâtiment G</option>
                                    <option value="H">Bâtiment H</option>
                                    <option value="I">Bâtiment I</option>
                                    <option value="J">Bâtiment J</option>
                                    <option value="K">Bâtiment K</option>
                                    <option value="L">Bâtiment L</option>
                                    <option value="M">Bâtiment M</option>
                                    <option value="N">Bâtiment N</option>
                                </select>
                                <input type="text" id="riadCityAppt" placeholder="N° Appt (opt.)" class="input">
                            </div>
                        </div>

                        <!-- Riad Prestige -->
                        <div id="deliveryRiadPrestige" class="form-row" style="display: none;">
                            <label for="riadPrestigeVilla">Riad Prestige Villa *</label>
                            <select id="riadPrestigeVilla" class="input">
                                <option value="">Sélectionnez la villa *</option>
                                <option value="1">Villa 1</option>
                                <option value="2">Villa 2</option>
                                <option value="3">Villa 3</option>
                                <option value="4">Villa 4</option>
                                <option value="5">Villa 5</option>
                                <option value="6">Villa 6</option>
                                <option value="7">Villa 7</option>
                                <option value="8">Villa 8</option>
                                <option value="9">Villa 9</option>
                                <option value="10">Villa 10</option>
                                <option value="11">Villa 11</option>
                                <option value="12">Villa 12</option>
                                <option value="13">Villa 13</option>
                                <option value="14">Villa 14</option>
                                <option value="15">Villa 15</option>
                                <option value="16">Villa 16</option>
                                <option value="17">Villa 17</option>
                                <option value="18">Villa 18</option>
                                <option value="19">Villa 19</option>
                                <option value="20">Villa 20</option>
                                <option value="21">Villa 21</option>
                                <option value="22">Villa 22</option>
                                <option value="23">Villa 23</option>
                                <option value="24">Villa 24</option>
                                <option value="25">Villa 25</option>
