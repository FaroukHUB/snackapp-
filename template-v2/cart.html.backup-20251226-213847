    <script src="js/cart.js"></script>
    <script>
        /* ============================================
           CART PAGE LOGIC
           ============================================ */
        const CartPage = {
            mode: 'pickup',
            discount: 0,

            async init() {
                // Load config
                await Config.init();

                // Check delivery setting and hide option if disabled
                const deliveryEnabled = Config.restaurant?.delivery?.enabled ?? true;
                const deliveryOption = document.querySelector('.mode-option[data-mode="delivery"]');
                if (!deliveryEnabled && deliveryOption) {
                    deliveryOption.style.display = 'none';
                    // Make pickup take full width
                    document.querySelector('.mode-selector').style.gridTemplateColumns = '1fr';
                }

                // Initialize cart
                Cart.init();
                Cart.onUpdate = () => this.render();

                // Initial render
                this.render();
            },

            /**
             * Échappe le HTML pour prévenir les attaques XSS
             */
            escapeHtml(text) {
                if (!text) return '';
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            },

            render() {
                const isEmpty = Cart.isEmpty();

                document.getElementById('cartEmpty').style.display = isEmpty ? 'block' : 'none';
                document.getElementById('cartContent').style.display = isEmpty ? 'none' : 'block';

                if (!isEmpty) {
                    this.renderItems();
                    this.renderUpsell();
                    this.updateSummary();
                }
            },

            renderItems() {
                const container = document.getElementById('cartItems');
                if (!container) return;

                container.innerHTML = Cart.items.map(item => {
                    const menuType = item.options?.menuType;
                    const removedIngredients = item.options?.removedIngredients || [];

                    // Échapper les guillemets simples pour les onclick
                    const safeKey = (item.key || '').replace(/'/g, "\\'");

                    return `
                    <div class="cart-item" data-key="${item.key}">
                        <img src="../${item.image}" alt="${item.name}" class="cart-item-image"
                             onerror="this.style.display='none'">
                        <div class="cart-item-details">
                            <div class="cart-item-name">
                                ${item.name}
                                ${menuType === 'menu' ? '<span style="background: var(--primary); color: white; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-left: 6px;">MENU</span>' : ''}
                            </div>
                            ${item.supplements.length > 0 ? `
                                <div class="cart-item-supplements" style="color: var(--success);">
                                    <i class="fas fa-plus-circle" style="font-size: 11px;"></i> ${item.supplements.map(s => s.name).join(', ')}
                                </div>
                            ` : ''}
                            ${removedIngredients.length > 0 ? `
                                <div class="cart-item-removed" style="color: var(--error); font-size: 13px;">
                                    <i class="fas fa-minus-circle" style="font-size: 11px;"></i> Sans: ${removedIngredients.join(', ')}
                                </div>
                            ` : ''}
                            ${item.options?.selectedKidsCrepe || item.options?.selectedKidsSauce ? `
                                <div class="cart-item-options" style="color: var(--gray-600); font-size: 13px;">
                                    <i class="fas fa-info-circle" style="font-size: 11px;"></i> ${item.options?.selectedKidsCrepe ? item.options.selectedKidsCrepe.name : ''}${item.options?.selectedKidsCrepe && item.options?.selectedKidsSauce ? ', ' : ''}${item.options?.selectedKidsSauce ? item.options.selectedKidsSauce.name : ''}
                                </div>
                            ` : ''}
                            <div class="cart-item-price">${Config.formatPrice(Cart.getItemTotal(item))}</div>
                        </div>
                        <div class="cart-item-actions">
                            <button class="cart-item-remove" onclick="Cart.removeItem('${safeKey}')">
                                <i class="fas fa-trash"></i>
                            </button>
                            <div class="cart-item-qty">
                                <button onclick="Cart.decrement('${safeKey}')">
                                    <i class="fas fa-minus"></i>
                                </button>
                                <span>${item.quantity}</span>
                                <button onclick="Cart.increment('${safeKey}')">
                                    <i class="fas fa-plus"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `}).join('');
            },

            renderUpsell() {
                const section = document.getElementById('upsellSection');
                const grid = document.getElementById('upsellGrid');
                const message = document.getElementById('upsellMessage');

                if (!grid) return;

                const categories = Cart.getCartCategories();
                const suggestions = Config.getUpsellSuggestions(categories);

                if (suggestions.length === 0) {
                    section.style.display = 'none';
                    return;
                }

                section.style.display = 'block';

                // Get first upsell message
                if (suggestions[0]?.upsellMessage) {
                    message.textContent = suggestions[0].upsellMessage;
                }

                grid.innerHTML = suggestions.map(product => {
                    const price = product.price || product.priceSolo || 0;
                    const hasImage = product.image && product.image.length > 0;

                    // Échapper les guillemets pour les attributs HTML
                    const safeId = (product.id || '').replace(/'/g, "\\'");
                    const safeName = (product.name || '').replace(/"/g, '&quot;');
                    const safeImage = (product.image || '').replace(/"/g, '&quot;');

                    return `
                        <div class="upsell-card" onclick="CartPage.quickAddUpsell('${safeId}')">
                            ${hasImage ? `<img src="../${safeImage}" alt="${safeName}" onerror="this.style.display='none'">` : '<div class="upsell-placeholder"><i class="fas fa-utensils"></i></div>'}
                            <div class="upsell-card-name">${product.name}</div>
                            <div class="upsell-card-price">+${Config.formatPrice(price)}</div>
                        </div>
                    `;
                }).join('');
            },

            quickAddUpsell(productId) {
                console.log('🔍 quickAddUpsell appelé avec ID:', productId);
                const product = Config.getProduct(productId);
                console.log('📦 Produit trouvé:', product);

                if (!product) {
                    console.error('❌ Produit non trouvé pour ID:', productId);
                    this.showToast('Produit non trouvé', 'error');
                    return;
                }

                console.log('🔎 hasBeverageOptions:', product.hasBeverageOptions);
                console.log('🔎 hasViennoiserieOptions:', product.hasViennoiserieOptions);
                console.log('🔎 hasPâtisserieOptions:', product.hasPâtisserieOptions);

                // Si le produit a des options (modal requis), ouvrir le modal
                if (product.hasBeverageOptions || product.hasViennoiserieOptions || product.hasPâtisserieOptions) {
                    console.log('✅ Ouverture du modal pour:', product.name);
                    this.openUpsellModal(product);
                } else {
                    // Sinon ajouter directement
                    console.log('✅ Ajout direct au panier:', product.name);
                    Cart.addItem(product, 1, [], {});
                    this.showToast(`${product.name} ajouté au panier`, 'success');
                }
            },

            currentUpsellProduct: null,
            selectedUpsellOptions: {},

            openUpsellModal(product) {
                console.log('🔓 openUpsellModal appelé avec produit:', product);
                this.currentUpsellProduct = product;
                this.selectedUpsellOptions = {};

                const modalBody = document.getElementById('upsellModalBody');
                console.log('📦 modalBody trouvé:', modalBody);

                if (!modalBody) {
                    console.error('❌ Element upsellModalBody non trouvé!');
                    return;
                }

                let optionsHTML = `
                    <h2 style="margin-bottom: 16px;">${product.name}</h2>
                    <p style="color: var(--gray-500); margin-bottom: 24px;">${product.description || ''}</p>
                `;

                // Afficher les options de boisson
                if (product.hasBeverageOptions && product.beverageOptions) {
                    console.log('🥤 Ajout options boisson:', product.beverageOptions);
                    optionsHTML += `
                        <div style="margin-bottom: 20px;">
                            <h3 style="margin-bottom: 12px;">Choisissez votre boisson:</h3>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                ${product.beverageOptions.map(opt => `
                                    <button class="option-btn" data-option-type="beverage" data-option-id="${opt.id}"
                                            onclick="CartPage.selectUpsellOption('beverage', '${opt.id}', '${opt.name}')">
                                        ${opt.name}
                                    </button>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                // Afficher les options de viennoiserie
                if (product.hasViennoiserieOptions && product.viennoiserieOptions) {
                    console.log('🥐 Ajout options viennoiserie:', product.viennoiserieOptions);
                    optionsHTML += `
                        <div style="margin-bottom: 20px;">
                            <h3 style="margin-bottom: 12px;">Choisissez votre viennoiserie:</h3>
                            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                                ${product.viennoiserieOptions.map(opt => `
                                    <button class="option-btn" data-option-type="viennoiserie" data-option-id="${opt.id}"
                                            onclick="CartPage.selectUpsellOption('viennoiserie', '${opt.id}', '${opt.name}')">
                                        ${opt.name}
                                    </button>
                                `).join('')}
                            </div>
                        </div>
                    `;
                }

                console.log('📝 HTML généré, mise à jour du modal...');
                modalBody.innerHTML = optionsHTML;

                const modal = document.getElementById('upsellModal');
                console.log('🎯 Modal element:', modal);

                if (!modal) {
                    console.error('❌ Element upsellModal non trouvé!');
                    return;
                }

                console.log('✅ Affichage du modal...');
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
                console.log('✅ Modal affiché!');
            },

            selectUpsellOption(type, id, name) {
                // Enregistrer l'option sélectionnée
                this.selectedUpsellOptions[type] = {id, name};

                // Mettre à jour l'affichage
                document.querySelectorAll(`[data-option-type="${type}"]`).forEach(btn => {
                    btn.classList.toggle('selected', btn.dataset.optionId === id);
                });
            },

            closeUpsellModal() {
                document.getElementById('upsellModal').style.display = 'none';
                document.body.style.overflow = '';
                this.currentUpsellProduct = null;
                this.selectedUpsellOptions = {};
            },

            addUpsellToCart() {
                if (!this.currentUpsellProduct) return;

                const options = {};
                if (this.selectedUpsellOptions.beverage) {
                    options.selectedBeverage = this.selectedUpsellOptions.beverage;
                }
                if (this.selectedUpsellOptions.viennoiserie) {
                    options.selectedViennoiserie = this.selectedUpsellOptions.viennoiserie;
                }

                Cart.addItem(this.currentUpsellProduct, 1, [], options);
                this.showToast(`${this.currentUpsellProduct.name} ajouté au panier`, 'success');
                this.closeUpsellModal();
                this.render();
            },

            updateSummary() {
                const subtotal = Cart.getSubtotal();
                const total = subtotal - this.discount;

                document.getElementById('summarySubtotal').textContent = Config.formatPrice(subtotal);
                document.getElementById('summaryTotal').textContent = Config.formatPrice(total);

                if (this.discount > 0) {
                    document.getElementById('discountRow').style.display = 'flex';
                    document.getElementById('summaryDiscount').textContent = `-${Config.formatPrice(this.discount)}`;
                } else {
                    document.getElementById('discountRow').style.display = 'none';
                }
            },

            clearCart() {
                if (confirm('Voulez-vous vraiment vider le panier ?')) {
                    Cart.clear();
                    this.render();
                    this.showToast('Panier vidé', 'success');
                }
            },

            setMode(mode) {
                this.mode = mode;

                // Update button selection (only for mode buttons, not room buttons)
                document.querySelectorAll('[data-mode]').forEach(opt => {
                    opt.classList.toggle('selected', opt.dataset.mode === mode);
                });

                // Show/hide fields based on mode
                document.getElementById('dineinFields').style.display = mode === 'dinein' ? 'block' : 'none';
                document.getElementById('deliveryFields').style.display = mode === 'delivery' ? 'block' : 'none';
            },

            setRoom(room) {
                this.room = room;

                // Update room selection
                document.querySelectorAll('[data-room]').forEach(opt => {
                    opt.classList.toggle('selected', opt.dataset.room === room);
                });
            },

            setDeliveryType(type) {
                this.deliveryType = type;

                // Hide all delivery sub-fields
                document.getElementById('deliveryLibre').style.display = 'none';
                document.getElementById('deliveryRiadCity').style.display = 'none';
                document.getElementById('deliveryRiadPrestige').style.display = 'none';

                // Show selected type
                if (type === 'libre') {
                    document.getElementById('deliveryLibre').style.display = 'block';
                } else if (type === 'riad-city') {
                    document.getElementById('deliveryRiadCity').style.display = 'block';
                } else if (type === 'riad-prestige') {
                    document.getElementById('deliveryRiadPrestige').style.display = 'block';
                }
            },

            applyPromo() {
                const code = document.getElementById('promoCode').value.trim().toUpperCase();

                // Simple promo logic - can be extended
                if (code === 'BIENVENUE10') {
                    this.discount = Cart.getSubtotal() * 0.10;
                    this.showToast('Code promo appliqué : -10%', 'success');
                } else if (code === 'FABRIK5') {
                    this.discount = 5;
                    this.showToast('Code promo appliqué : -500 DA', 'success');
                } else {
                    this.discount = 0;
                    this.showToast('Code promo invalide', 'error');
                }

                this.updateSummary();
            },

            async submitOrder() {
                const name = document.getElementById('customerName').value.trim();
                const countryCode = document.getElementById('countryCode').value;
                const phoneNumber = document.getElementById('customerPhone').value.trim();
                const note = document.getElementById('customerNote').value.trim();

                // Validation générale
                if (!name) {
                    this.showToast('Veuillez entrer votre nom', 'error');
                    return;
                }
                if (!countryCode) {
                    this.showToast('Veuillez sélectionner votre pays', 'error');
                    return;
                }
                if (!phoneNumber) {
                    this.showToast('Veuillez entrer votre téléphone', 'error');
                    return;
                }

                // Validation format téléphone
                const phoneRegex = /^[0-9\s\-\(\)]{6,20}$/;
                if (!phoneRegex.test(phoneNumber)) {
                    this.showToast('Format de téléphone invalide', 'error');
                    return;
                }

                // Enlever espaces, tirets et parenthèses
                const cleanPhone = phoneNumber.replace(/[\s\-\(\)]/g, '');
                if (cleanPhone.length < 6 || cleanPhone.length > 15) {
                    this.showToast('Numéro de téléphone trop court ou trop long', 'error');
                    return;
                }

                // Combiner code pays + numéro (enlever le 0 initial si présent)
                const phone = countryCode + cleanPhone.replace(/^0+/, '');

                // Validation Sur place
                if (this.mode === 'dinein') {
                    if (!this.room) {
                        this.showToast('Veuillez sélectionner la salle', 'error');
                        return;
                    }
                    const tableNumber = document.getElementById('tableNumber').value.trim();
                    if (!tableNumber) {
                        this.showToast('Veuillez entrer le numéro de table', 'error');
                        return;
                    }
                }

                // Validation Livraison
                if (this.mode === 'delivery') {
                    const deliveryType = this.deliveryType || 'libre';

                    if (deliveryType === 'libre') {
                        const address = document.getElementById('customerAddress').value.trim();
                        if (!address) {
                            this.showToast('Veuillez entrer votre adresse', 'error');
                            return;
                        }
                    } else if (deliveryType === 'riad-city') {
                        const bat = document.getElementById('riadCityBat').value;
                        if (!bat) {
                            this.showToast('Veuillez sélectionner le bâtiment', 'error');
                            return;
                        }
                    } else if (deliveryType === 'riad-prestige') {
                        const villa = document.getElementById('riadPrestigeVilla').value;
                        if (!villa) {
                            this.showToast('Veuillez sélectionner la villa', 'error');
                            return;
                        }
                    }
                }

                // Disable button during submission
                const submitBtn = document.getElementById('submitOrder');
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Envoi en cours...';

                // Save cart data BEFORE any operation (will be cleared later)
                const savedItems = JSON.parse(JSON.stringify(Cart.items));
                const savedSubtotal = Cart.getSubtotal();
                const savedDiscount = this.discount;

                console.log('Cart items:', savedItems);
                console.log('Subtotal:', savedSubtotal);

                // Format items for API (don't send product_id - it's a string, DB expects int)
                const formattedItems = savedItems.map(item => {
                    const itemPrice = item.basePrice || 0;
                    const supplementsTotal = (item.supplements || []).reduce((sum, s) => sum + (s.price || 0), 0);

                    // Collecter TOUTES les options du produit
                    const options = {};
                    if (item.options?.selectedDrink) options.boisson = item.options.selectedDrink.name;
                    if (item.options?.selectedKidsCrepe) options.crepe = item.options.selectedKidsCrepe.name;
                    if (item.options?.selectedKidsSauce) options.sauce = item.options.selectedKidsSauce.name;
                    if (item.options?.selectedSauce) options.sauce = item.options.selectedSauce.name;
                    if (item.options?.selectedAccompagnement) options.accompagnement = item.options.selectedAccompagnement;
                    if (item.options?.selectedViennoiserie) options.viennoiserie = item.options.selectedViennoiserie.name;
                    if (item.options?.selectedPatisserie) options.patisserie = item.options.selectedPatisserie.name;
                    if (item.options?.selectedBeverage) options.boisson = item.options.selectedBeverage.name;

                    return {
                        name: item.name,
                        price: itemPrice + supplementsTotal,
                        quantity: item.quantity,
                        variant: item.options?.menuType || 'solo',
                        supplements: item.supplements || [],
                        removed_ingredients: item.options?.removedIngredients || [],
                        selected_drink: item.options?.selectedDrink?.name || null,
                        selected_options: Object.keys(options).length > 0 ? options : null
                    };
                });

                const totalAmount = savedSubtotal - savedDiscount;

                // Build notes based on mode
                let modeNotes = '';
                if (this.mode === 'dinein') {
                    const tableNumber = document.getElementById('tableNumber').value.trim();
                    const salleName = this.room === 'famille' ? 'Salle Famille' : 'Salle Femme';
                    modeNotes = `🏠 SUR PLACE - ${salleName} - Table ${tableNumber}`;
                } else if (this.mode === 'pickup') {
                    modeNotes = '📦 À EMPORTER';
                } else if (this.mode === 'delivery') {
                    const deliveryType = this.deliveryType || 'libre';

                    if (deliveryType === 'libre') {
                        const address = document.getElementById('customerAddress').value.trim();
                        modeNotes = `🚗 LIVRAISON: ${address}`;
                    } else if (deliveryType === 'riad-city') {
                        const bat = document.getElementById('riadCityBat').value;
                        const appt = document.getElementById('riadCityAppt').value.trim();
                        modeNotes = `🚗 LIVRAISON: Riad City Bât ${bat}${appt ? ' - Appt ' + appt : ''}`;
                    } else if (deliveryType === 'riad-prestige') {
                        const villa = document.getElementById('riadPrestigeVilla').value;
                        modeNotes = `🚗 LIVRAISON: Riad Prestige Villa ${villa}`;
                    }
                }

                // Prepare order data for admin API
                const orderData = {
                    action: 'add',
                    customer_name: name,
                    customer_phone: phone,
                    items: formattedItems,
                    subtotal: savedSubtotal,
                    total: totalAmount,
                    notes: [modeNotes, note].filter(Boolean).join(' | ')
                };

                console.log('Order data being sent:', orderData);

                // Send to admin API
                try {
                    const response = await fetch('../admin-panel-v2/api/orders.php', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(orderData)
                    });

                    const result = await response.json();
                    console.log('API Response:', result);

                    if (result.success || result.order_id) {
                        // Show confirmation with real order number from API
                        const orderNumber = result.order_id || result.order?.order_number || 'XXXX';
                        const loyaltyPoints = result.loyalty_points || result.order?.loyalty_points || 0;
                        const loyaltyCard = result.loyalty_code || result.order?.loyalty_code || null;
                        this.showConfirmation(orderNumber, name, phone, modeNotes, note, savedItems, savedSubtotal, savedDiscount, loyaltyPoints, loyaltyCard);
                    } else {
                        // API returns 'message' not 'error'
                        throw new Error(result.message || result.error || 'Erreur lors de la commande');
                    }

                } catch (error) {
                    console.error('Order error:', error);
                    this.showToast('Erreur: ' + error.message, 'error');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<i class="fas fa-check"></i> Confirmer la commande';
                }
            },

            showConfirmation(orderNumber, customerName, customerPhone, customerAddress, note, items, subtotal, discount, loyaltyPoints = 0, loyaltyCard = null) {
                // Update modal
                document.getElementById('confirmationOrderNumber').textContent = `#${orderNumber}`;

                // Show loyalty card if available
                const loyaltyCardDiv = document.getElementById('confirmationLoyaltyCard');
                if (loyaltyCard) {
                    document.getElementById('confirmationLoyaltyCardNumber').textContent = loyaltyCard;
                    loyaltyCardDiv.style.display = 'inline-block';
                } else {
                    loyaltyCardDiv.style.display = 'none';
                }

                // Show loyalty points if earned
                const loyaltyDiv = document.getElementById('loyaltyEarned');
                if (loyaltyPoints > 0) {
                    document.getElementById('loyaltyPointsText').textContent = `+${loyaltyPoints} points fidélité gagnés !`;
                    loyaltyDiv.style.display = 'block';
                } else {
                    // Calculate points based on total (1 point per euro)
                    const estimatedPoints = Math.floor(subtotal - discount);
                    if (estimatedPoints > 0) {
                        document.getElementById('loyaltyPointsText').textContent = `+${estimatedPoints} points fidélité gagnés !`;
                        loyaltyDiv.style.display = 'block';
                    } else {
                        loyaltyDiv.style.display = 'none';
                    }
                }

                // Generate receipt link
                const receiptLink = this.generateReceiptLink(
                    orderNumber,
                    customerName,
                    customerPhone,
                    customerAddress,
                    items,
                    subtotal,
                    discount
                );
                document.getElementById('whatsappSelfLink').href = receiptLink;

                // Show modal
                document.getElementById('confirmationModal').classList.add('active');

                // Clear cart
                Cart.clear();
            },

            generateReceiptLink(orderNumber, customerName, customerPhone, customerAddress, items, subtotal, discount) {
                const restaurant = Config.restaurant || {};
                const now = new Date();
                const dateStr = now.toLocaleDateString('fr-FR');
                const timeStr = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });

                const total = subtotal - discount;
                const tvaRate = 0.10; // 10% TVA restauration
                const totalHT = total / (1 + tvaRate);
                const tvaAmount = total - totalHT;

                let receipt = `🧾 *TICKET DE CAISSE*\n`;
                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n\n`;

                // Restaurant header
                receipt += `*${restaurant.name || 'Restaurant'}*\n`;
                receipt += `${Config.getFullAddress()}\n`;
                receipt += `Tél: ${restaurant.contact?.phoneDisplay || restaurant.contact?.phone || ''}\n\n`;

                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n`;
                receipt += `📅 ${dateStr} à ${timeStr}\n`;
                receipt += `🎫 Commande N° *${orderNumber}*\n`;
                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n\n`;

                // Customer info
                receipt += `👤 *Client:* ${customerName}\n`;
                receipt += `📱 ${customerPhone}\n`;
                if (customerAddress) {
                    receipt += `📍 ${customerAddress}\n`;
                }
                receipt += `\n━━━━━━━━━━━━━━━━━━━━━━━━\n`;
                receipt += `📋 *DÉTAIL COMMANDE*\n`;
                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n\n`;

                // Items
                items.forEach(item => {
                    const itemTotal = (item.basePrice + (item.supplements || []).reduce((sum, s) => sum + (s.price || 0), 0)) * item.quantity;
                    receipt += `${item.quantity}x ${item.name}\n`;
                    receipt += `   ${Config.formatPrice(itemTotal)}\n`;

                    // Menu type
                    if (item.options?.menuType === 'menu') {
                        receipt += `   → Menu\n`;
                    }

                    // Drink
                    if (item.options?.selectedDrink) {
                        receipt += `   🥤 ${item.options.selectedDrink.name}\n`;
                    }

                    // Supplements
                    if (item.supplements && item.supplements.length > 0) {
                        item.supplements.forEach(sup => {
                            receipt += `   + ${sup.name} (${Config.formatPrice(sup.price)})\n`;
                        });
                    }

                    // Removed ingredients
                    if (item.options?.removedIngredients && item.options.removedIngredients.length > 0) {
                        receipt += `   ❌ Sans: ${item.options.removedIngredients.join(', ')}\n`;
                    }
                    receipt += `\n`;
                });

                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n`;
                receipt += `Sous-total: ${Config.formatPrice(subtotal)}\n`;
                if (discount > 0) {
                    receipt += `Remise: -${Config.formatPrice(discount)}\n`;
                }
                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n`;
                receipt += `Total HT: ${Config.formatPrice(totalHT)}\n`;
                receipt += `TVA (10%): ${Config.formatPrice(tvaAmount)}\n`;
                receipt += `*TOTAL TTC: ${Config.formatPrice(total)}*\n`;
                receipt += `━━━━━━━━━━━━━━━━━━━━━━━━\n\n`;

                receipt += `✅ *Commande confirmée*\n`;
                receipt += `Merci de votre visite !\n\n`;
                receipt += `_Ce ticket fait foi de justificatif._`;

                // Send to customer's own WhatsApp
                const cleanPhone = customerPhone.replace(/[^0-9]/g, '');
                // Add French country code if not present
                const fullPhone = cleanPhone.startsWith('33') ? cleanPhone : '33' + cleanPhone.replace(/^0/, '');

                return `https://wa.me/${fullPhone}?text=${encodeURIComponent(receipt)}`;
            },

            showToast(message, type = 'success') {
                const container = document.getElementById('toastContainer');
                if (!container) return;

                const toast = document.createElement('div');
                toast.className = `toast ${type}`;
                toast.innerHTML = `
                    <i class="fas fa-${type === 'success' ? 'check-circle' : 'exclamation-circle'}"></i>
                    <span>${message}</span>
                `;

                container.appendChild(toast);
                setTimeout(() => toast.remove(), 3000);
            }
        };

        // Initialize on load
        document.addEventListener('DOMContentLoaded', () => {
            CartPage.init();
        });
    </script>
</body>
</html>
